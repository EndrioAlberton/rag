# Copy to .env and adjust (do not commit .env):
#   cp .env.example .env
#
# Subir o stack (RAG migra antes do Orion Users — ver docker-compose.yml):
#   ./config/scripts/docker-compose-up.sh
#
# Docker Compose loads .env automatically when you run: docker compose up --build

# --- Required for OpenAI API ---
OPENAI_API_KEY=sk-proj-example-replace-with-your-key

# --- Quarkus app (optional; defaults match docker-compose) ---
# QUARKUS_PROFILE=prod
# RAG_HOST_PORT=80

# --- Database (must match POSTGRES_* below if you change user/password/db) ---
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/orion_rag
# QUARKUS_DATASOURCE_REACTIVE_URL=postgresql://postgres:5432/orion_rag
# QUARKUS_DATASOURCE_USERNAME=orion
# QUARKUS_DATASOURCE_PASSWORD=orion

# --- Redis ---
# QUARKUS_REDIS_HOSTS=redis://redis:6379

# --- PostgreSQL service in Compose (optional) ---
# POSTGRES_USER=orion
# POSTGRES_PASSWORD=orion
# POSTGRES_DB=orion_rag
# POSTGRES_HOST_PORT=5432

# --- Redis service in Compose (optional) ---
# REDIS_HOST_PORT=6379

# --- Orion Users (Compose service orion-users; same POSTGRES_DB as RAG) ---
# Host port for the auth API (frontend default VITE_ORION_USERS_URL=http://localhost:8080).
# ORION_USERS_HOST_PORT=8080
# QUARKUS_MAILER_MOCK=true

# --- WhatsApp Cloud API (Meta) — optional; web UI works without these ---
# Needed to send replies from /webhook/whatsapp (Graph API).
# Meta App Dashboard → WhatsApp → API setup: copy "Phone number ID" and a valid access token.
#
# WHATSAPP_PHONE_NUMBER_ID must be the long numeric "Phone number ID" from the dashboard — NOT your
# business phone number (do not use +55..., +1..., or spaces). Example shape: 106937148759123
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# Must match the "Verify token" when you register the callback URL in Meta (default in app: rag-webhook-verify).
# WHATSAPP_VERIFY_TOKEN=rag-webhook-verify
#
# Quarkus dev loads .env from the current working directory — run ./mvnw quarkus:dev from the repo root.
# If WHATSAPP_* is still empty: an empty OS/IDE environment variable OVERRIDES .env (priority 300 vs 295).
# Fix: unset WHATSAPP_PHONE_NUMBER_ID WHATSAPP_ACCESS_TOKEN or remove them from the run configuration.
# Docker Compose loads .env and passes WHATSAPP_* into the rag container (see docker-compose.yml).
