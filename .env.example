# Copy to .env and adjust (do not commit .env):
#   cp .env.example .env
#
# Docker Compose loads .env automatically when you run: docker compose up --build

# --- Required for OpenAI API ---
OPENAI_API_KEY=sk-proj-example-replace-with-your-key

# --- Quarkus app (optional; defaults match docker-compose) ---
# QUARKUS_PROFILE=prod
# RAG_HOST_PORT=80

# --- Database (must match POSTGRES_* below if you change user/password/db) ---
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://postgres:5432/orion_rag
# QUARKUS_DATASOURCE_REACTIVE_URL=postgresql://postgres:5432/orion_rag
# QUARKUS_DATASOURCE_USERNAME=orion
# QUARKUS_DATASOURCE_PASSWORD=orion

# --- Redis ---
# QUARKUS_REDIS_HOSTS=redis://redis:6379

# --- PostgreSQL service in Compose (optional) ---
# POSTGRES_USER=orion
# POSTGRES_PASSWORD=orion
# POSTGRES_DB=orion_rag
# POSTGRES_HOST_PORT=5432

# --- Redis service in Compose (optional) ---
# REDIS_HOST_PORT=6379
